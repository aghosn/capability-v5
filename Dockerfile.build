# Dockerfile.build — build-only toolchain image for the Themis project.
# It compiles the Rust workspace, builds the thhv kernel module, and packs
# guest/bins.img from a bind-mounted checkout. QEMU is intentionally excluded:
# all VM execution is expected to run natively on the host.
FROM ubuntu:24.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:${PATH}

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    apt-utils \
    build-essential \
    ca-certificates \
    clang \
    cloud-image-utils \
    cmake \
    curl \
    dpkg-dev \
    e2fsprogs \
    fuse2fs \
    fuse3 \
    git \
    grub-pc-bin \
    libclang-dev \
    libssl-dev \
    llvm \
    mtools \
    pkg-config \
    qemu-utils \
    wget \
    xorriso \
    # Optional: software TPM for attested boot testing (swtpm ≥ 0.8 recommended)
    swtpm \
    swtpm-tools \
 && rm -rf /var/lib/apt/lists/*

# themis/rust-toolchain.toml currently pins channel=nightly,
# target=x86_64-unknown-none, and the listed components below.
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none \
 && rustup toolchain install nightly \
    --component rust-src \
    --component rust-analyzer \
    --component rustfmt \
    --component clippy \
    --component llvm-tools \
    --target x86_64-unknown-none \
 && rustup default nightly \
 && chmod -R a+rwX /usr/local/cargo /usr/local/rustup \
 && ln -s /usr/bin/fusermount3 /usr/local/bin/fusermount

WORKDIR /workspace
VOLUME ["/workspace"]

CMD ["/bin/bash"]
